@@ -0,0 +1,69 @@
+from __future__ import annotations
+
+import os
+import re
+
+import mujoco
+
+from sim2real.config.robots.base import RobotCfg
+
+# RoboParty RP1 (rp1_28dof): UFO's capsule-collision mjlab MJCF (XML motors named after their joints), with RoboParty's
+# current effort / velocity limits, armatures and standing pose (robolab RP1_24DOF_CFG at 45cdc13; the wrist yaw / pitch
+# joints it lacks take its wrist's values and a zero default) and rp1_description's joint frictionloss 0.1 (8c12d13).
+# RP1_MJCF: PartyMimic's data/rp1_28dof_mjlab/rp1_28dof.xml (tools/download_data.sh); scripts/eval.sh sets it.
+RP1_MJCF_PATH = os.environ.get("RP1_MJCF", "")
+
+# (joint regex, effort limit, velocity limit, armature)
+_LIMITS = (
+    ("waist_(roll|yaw)_joint|.*_hip_(pitch|roll)_joint|.*_knee_joint", 140.0, 13.61357, 0.0290856),
+    (".*_(hip_yaw|shoulder_pitch)_joint", 55.0, 16.23156, 0.00884),
+    (".*_ankle_(pitch|roll)_joint", 64.0, 15.70796, 0.006266268),
+    (".*_(shoulder_(roll|yaw)|elbow|wrist_(roll|yaw|pitch))_joint", 32.0, 15.70796, 0.00313313),
+)
+DEFAULT_JOINT_POS = {
+    "left_hip_pitch_joint": -0.1, "right_hip_pitch_joint": 0.1,
+    "left_knee_joint": -0.3, "right_knee_joint": 0.3,
+    "left_ankle_pitch_joint": -0.2, "right_ankle_pitch_joint": -0.2,
+    "left_shoulder_pitch_joint": 0.2, "right_shoulder_pitch_joint": -0.2,
+    "left_shoulder_roll_joint": 0.2, "right_shoulder_roll_joint": -0.2,
+    "left_elbow_joint": -1.2, "right_elbow_joint": 1.2,
+}  # fmt: skip
+
+
+def _limit(joint: str, i: int) -> float:
+    for pat, *vals in _LIMITS:
+        if re.fullmatch(pat, joint):
+            return vals[i]
+    raise KeyError(joint)
+
+
+def _parse() -> tuple[tuple[str, ...], tuple[str, ...], dict[str, tuple[float, float]]]:
+    if not RP1_MJCF_PATH:
+        return (), (), {}
+    m = mujoco.MjModel.from_xml_path(RP1_MJCF_PATH)
+    joints = [i for i in range(m.njnt) if m.jnt_type[i] != mujoco.mjtJoint.mjJNT_FREE]
+    names = tuple(m.joint(i).name for i in joints)
+    bodies = tuple(m.body(i).name for i in range(1, m.nbody))
+    return names, bodies, {m.joint(i).name: tuple(float(x) for x in m.jnt_range[i]) for i in joints}
+
+
+RP1_JOINT_NAMES, RP1_BODY_NAMES, _RANGES = _parse()
+
+RP1_CFG = RobotCfg(
+    name="rp1",
+    joint_names=RP1_JOINT_NAMES,
+    body_names=RP1_BODY_NAMES,
+    joint_pos_lower_limit={j: r[0] for j, r in _RANGES.items()},
+    joint_pos_upper_limit={j: r[1] for j, r in _RANGES.items()},
+    joint_velocity_limit={j: _limit(j, 1) for j in RP1_JOINT_NAMES},
+    joint_effort_limit={j: _limit(j, 0) for j in RP1_JOINT_NAMES},
+    joint_armature={j: _limit(j, 2) for j in RP1_JOINT_NAMES},
+    joint_frictionloss={j: 0.1 for j in RP1_JOINT_NAMES},
+    mjcf_path=RP1_MJCF_PATH,
+    default_qpos=(0.0, 0.0, 0.78, 1.0, 0.0, 0.0, 0.0, *(DEFAULT_JOINT_POS.get(j, 0.0) for j in RP1_JOINT_NAMES)),
+    root_joint_names=("base_link_freejoint",),
+    viewer_track_body_names=("base_link",),
+    elastic_band_attach_body_names=("waist_yaw_link", "base_link"),
+)
+
+__all__ = ["RP1_CFG", "RP1_JOINT_NAMES", "RP1_BODY_NAMES", "RP1_MJCF_PATH"]
